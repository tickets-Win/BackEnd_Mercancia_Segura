<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Default.master.vb" Inherits="WebAdmin._Default" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        :root {
            --sidebar-width: 250px;
        }

        body {
            overflow-x: hidden;
        }

        #sidebar {
            width: var(--sidebar-width);
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            height: 100vh;
            background-color: #fff;
            color: #000;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            overflow-y: auto;
        }

            #sidebar.collapsed {
                transform: translateX(-100%);
            }

        #content {
            transition: margin-left 0.3s ease, width 0.3s ease;
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            position: relative;
        }

            #content.expanded {
                margin-left: 0;
                width: 100%;
            }

        #toggle-btn {
            cursor: pointer;
        }

        .nav-link.active {
            background-color: #0d6efd;
            color: #fff !important;
            border-radius: 6px;
            font-weight: 500;
        }
    </style>
    <script>
        // Convierte un cuadro de texto con AutoPostBack en un buscador incremental.
        // Espera a que el usuario deje de teclear antes de ir al servidor, para no
        // lanzar una consulta por cada letra, y le devuelve el foco cuando el
        // UpdatePanel vuelve a pintar el control.
        //
        // El filtrado se queda en el servidor a proposito: filtrar en el navegador
        // solo alcanzaria las filas de la pagina visible del GridView.
        //
        // Se define en el encabezado a proposito: las pantallas lo invocan desde
        // sus propios scripts, que el navegador ejecuta antes de llegar al final
        // del documento. Cada pantalla debe llamarlo dentro de DOMContentLoaded,
        // para que el cuadro de texto y el objeto Sys del ScriptManager existan.
        function msBuscadorIncremental(clientId, uniqueId, retraso) {
            var timer = null;
            var enfocar = false;

            function enganchar() {
                var el = document.getElementById(clientId);
                if (!el || el.dataset.msBuscador) { return; }
                el.dataset.msBuscador = '1';

                el.addEventListener('input', function () {
                    clearTimeout(timer);
                    enfocar = true;

                    timer = setTimeout(function () {
                        __doPostBack(uniqueId, '');
                    }, retraso || 400);
                });
            }

            enganchar();

            if (typeof Sys !== 'undefined' && Sys.WebForms) {
                Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                    // El control es un nodo nuevo tras el postback parcial.
                    enganchar();

                    if (!enfocar) { return; }

                    var el = document.getElementById(clientId);
                    if (!el) { return; }

                    el.focus();

                    var valor = el.value;
                    el.value = '';
                    el.value = valor;
                });
            }
        }
    </script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <%-- Estilos del editor enriquecido y del envio de correo: los comparten
         el control de correo y la captura de plantillas. --%>
<style>
    .cor-titulo {
        color: #17406d;
        font-weight: 700;
    }

    .cor-volver {
        border: 1px solid #d7dee8;
        background: #fff;
        border-radius: .375rem;
        padding: .25rem .6rem;
        color: #17406d;
        text-decoration: none !important;
        line-height: 1.6;
    }

        .cor-volver:hover {
            background: #f1f5f9;
        }

    .cor-panel {
        background: #fff;
        border: 1px solid #e3e8ef;
        border-radius: .5rem;
    }

    .cor-panel-titulo {
        font-size: .8125rem;
        font-weight: 600;
        color: #1f2937;
        padding: .9rem .9rem .6rem;
    }

    .cor-label {
        font-size: .8125rem;
        color: #374151;
        text-align: right;
    }

    .cor-opciones {
        font-size: .75rem;
        color: #4b5563;
    }

    .cor-editor-barra {
        border: 1px solid #e3e8ef;
        border-bottom: none;
        background: #fff;
        padding: .35rem .5rem;
        display: flex;
        flex-wrap: wrap;
        gap: .15rem;
        align-items: center;
    }

    .cor-herramienta {
        border: none;
        background: transparent;
        border-radius: .25rem;
        padding: .1rem .3rem;
        font-size: .75rem;
        color: #475569;
        line-height: 1.5;
        text-decoration: none !important;
    }

        .cor-herramienta:hover {
            background: #eef2f7;
        }

    .cor-azul {
        color: #2563eb;
    }

    .cor-rojo {
        color: #dc2626;
    }

    .cor-verde {
        color: #16a34a;
    }

    .cor-select-mini {
        font-size: .6875rem;
        padding: .1rem 1.2rem .1rem .35rem;
        height: auto;
        width: auto;
        display: inline-block;
    }

    .cor-cuerpo {
        border: 1px solid #e3e8ef;
        border-radius: 0;
        min-height: 240px;
        resize: vertical;
        font-size: .8125rem;
    }

    .cor-editable {
        overflow-y: auto;
        padding: .6rem .75rem;
        background: #fff;
    }

        .cor-editable:focus {
            outline: none;
            border-color: #3b82f6;
        }

    .cor-oculto {
        display: none !important;
    }

    .cor-pestanas {
        border: 1px solid #e3e8ef;
        border-top: none;
        display: flex;
    }

    .cor-pestana {
        font-size: .75rem;
        color: #374151;
        padding: .45rem .9rem;
        border-right: 1px solid #e3e8ef;
        text-decoration: none !important;
        cursor: pointer;
    }

        .cor-pestana:hover {
            background: #f8fafc;
        }

    .cor-pestana-activa {
        background: #f8fafc;
        font-weight: 600;
    }

    .cor-enlace {
        display: block;
        padding: .55rem .9rem;
        font-size: .8125rem;
        color: #2563eb;
        border-top: 1px solid #eef2f7;
        text-decoration: none !important;
        cursor: pointer;
    }

        .cor-enlace:hover {
            background: #f8fafc;
        }

    .cor-archivo {
        max-width: 320px;
    }

    .cor-adjuntos {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
    }

    .cor-adjunto {
        background: #f1f5f9;
        border: 1px solid #e3e8ef;
        border-radius: 1rem;
        padding: .15rem .6rem;
        font-size: .75rem;
        color: #374151;
    }

    .cor-quitar {
        color: #dc2626;
        font-weight: 700;
        margin-left: .35rem;
        text-decoration: none !important;
    }
</style>
</head>
<body>
